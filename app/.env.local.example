# Dev-only Langfuse tracing (self-hosted). Copy to app/.env.local (gitignored) and fill in.
# Only active during `npm run dev` (import.meta.env.DEV); never included in production builds.
VITE_LANGFUSE_HOST=http://localhost:3000
VITE_LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
VITE_LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx
